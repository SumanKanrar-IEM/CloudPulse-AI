%% CloudPulse AI — governance record ERD (FR-028)
%%
%% MUST be updated in the same pull request as any schema change. CI enforces this:
%% the `erd-current` job fails a PR that touches backend/migrations/versions/ without
%% touching ops/erd/.
%%
%% Source of truth for the shape: backend/app/models/core.py and the migrations.
%% This diagram documents it; it does not define it.

erDiagram
    TENANT ||--o{ APP_USER : "owns"
    TENANT ||--o{ AUDIT_EVENT : "owns"
    TENANT ||--o{ CLOUD_ACCOUNT : "owns"
    TENANT ||--o{ RESOURCE : "owns"
    TENANT ||--o{ RULE : "owns"
    TENANT ||--o{ FINDING : "owns"
    TENANT ||--o{ SDA : "owns"
    TENANT ||--o{ RESOURCE_OWNER : "owns"
    TENANT ||--o{ SCAN : "owns"
    TENANT ||--o{ OWNER_IDENTITY_OVERRIDE : "owns"
    TENANT ||--o{ FINDING_REMEDIATION_SUGGESTION : "owns"
    TENANT ||--o{ SPEND_RECORD : "owns"
    TENANT ||--o{ BUDGET : "owns"
    TENANT ||--o{ NOTIFICATION : "owns"
    TENANT ||--o{ IAM_HYGIENE_FLAG : "owns"

    APP_USER ||--o{ AUDIT_EVENT : "acted as"
    APP_USER ||--o{ FINDING : "acknowledged"
    CLOUD_ACCOUNT ||--o{ RESOURCE : "contains"
    CLOUD_ACCOUNT ||--o{ SCAN : "scanned by"
    CLOUD_ACCOUNT ||--o{ SPEND_RECORD : "spends"
    CLOUD_ACCOUNT ||--o{ IAM_HYGIENE_FLAG : "flagged in"
    RESOURCE ||--o{ RESOURCE : "parent of"
    RESOURCE ||--o{ FINDING : "fails (tag_violation kind)"
    RULE ||--o{ FINDING : "produces (tag_violation kind)"
    RESOURCE ||--|| RESOURCE_OWNER : "attributed to"
    FINDING ||--|| FINDING_REMEDIATION_SUGGESTION : "has"
    FINDING ||--o{ NOTIFICATION : "notifies (spec 005)"
    SDA ||--o{ RESOURCE : "groups"
    SDA ||--o{ SPEND_RECORD : "attributes (spec 005, null = No SDA)"
    SDA ||--|| BUDGET : "has (spec 005)"
    SDA ||--o{ FINDING : "overruns (budget_overrun kind, spec 005)"

    TENANT {
        uuid id PK
        text name UK
        enum status "active|suspended"
        text owner_identity_pattern "spec 003 FR-028, P2"
    }
    APP_USER {
        uuid id PK
        uuid tenant_id FK
        text cognito_sub UK
        text email
        text display_name
        timestamptz last_seen_at
    }
    AUDIT_EVENT {
        uuid id PK
        uuid tenant_id FK
        uuid actor_user_id FK "null for system actors"
        text actor_label
        text action
        text target_type
        text target_id
        uuid correlation_id
        jsonb payload "redacted"
        timestamptz occurred_at
    }
    DEPLOYMENT {
        uuid id PK
        enum environment "dev|prod"
        text git_sha
        text triggered_by
        text approved_by "required for prod"
        timestamptz approved_at "required for prod"
        bool self_approved
        text migration_revision
        enum status
    }
    CLOUD_ACCOUNT {
        uuid id PK
        uuid tenant_id FK
        text aws_account_id UK
        text alias
        enum connection_mode "local|assume_role"
        text role_arn
        text external_id_ref "Secrets Manager REFERENCE"
        text_array scan_regions
        enum status
    }
    RESOURCE {
        uuid id PK
        uuid tenant_id FK
        uuid cloud_account_id FK
        text arn UK
        text resource_type
        text service
        text region
        jsonb tags "GIN indexed"
        uuid parent_resource_id FK
        timestamptz first_seen_at
        timestamptz last_seen_at
        text state "spec 002, migration 0009"
        timestamptz deleted_at "soft marker, spec 002 FR-030"
        jsonb detail "enrichment payload, spec 002 FR-019"
        uuid sda_id FK "spec 003, null = No SDA bucket"
    }
    RULE {
        uuid id PK
        uuid tenant_id FK
        text key UK
        int version UK
        jsonb definition "rules-as-data. Migration 0010's seed INSERT originally double-encoded this column (json.dumps of a dict passed into a JSONB bulk_insert) -- fixed by passing the dict directly; no shape change, noted here for the erd-current gate"
        bool enabled
        timestamptz effective_from
    }
    FINDING {
        uuid id PK
        uuid tenant_id FK
        uuid resource_id FK "nullable since migration 0012; NULL for budget_overrun kind"
        uuid rule_id FK "nullable since migration 0012; NULL for budget_overrun kind"
        int rule_version "pinned; nullable since migration 0012, NULL for budget_overrun kind"
        uuid sda_id FK "spec 005, migration 0012; set only for budget_overrun kind"
        enum kind "tag_violation|budget_overrun, spec 005 migration 0012, default tag_violation"
        enum severity
        enum status "open|resolved|suppressed"
        timestamptz opened_at
        timestamptz resolved_at
        timestamptz acknowledged_at "spec 004, orthogonal to status"
        uuid acknowledged_by FK "spec 004, app_user"
        timestamptz escalated_at "spec 005, migration 0012, orthogonal to status"
    }
    FINDING_REMEDIATION_SUGGESTION {
        uuid id PK
        uuid tenant_id FK
        uuid finding_id FK UK
        text suggestion_text
        text blast_radius_note
        enum source "ai_generated|admin_seeded"
    }
    SDA {
        uuid id PK
        uuid tenant_id FK
        text name UK
        text owner_email
        text team
        jsonb tag_values
    }
    SPEND_RECORD {
        uuid id PK
        uuid tenant_id FK
        uuid cloud_account_id FK
        uuid sda_id FK "spec 005, null = No SDA bucket"
        text service "null exactly when is_gap -- a gap has no per-service breakdown"
        date spend_date
        numeric amount_usd "null exactly when is_gap"
        bool is_gap "spec 005 FR-002a, no guessed/zeroed value"
        timestamptz ingested_at
    }
    BUDGET {
        uuid id PK
        uuid tenant_id FK
        uuid sda_id FK UK "spec 005, one budget per project"
        numeric amount_usd
        timestamptz actual_80_crossed_at
        timestamptz actual_100_crossed_at
        timestamptz forecast_80_crossed_at
        timestamptz forecast_100_crossed_at
    }
    NOTIFICATION {
        uuid id PK
        uuid tenant_id FK
        uuid finding_id FK
        enum cadence_point "day_0|day_2|day_4, spec 005"
        enum outcome "sent|withheld_no_owner_email|withheld_bounced|suppressed_finding_closed"
        text recipient_email "set only when outcome=sent"
        timestamptz attempted_at
    }
    IAM_HYGIENE_FLAG {
        uuid id PK
        uuid tenant_id FK
        uuid cloud_account_id FK
        enum principal_type "role|user|access_key, spec 005"
        text principal_identifier "ARN or access key id"
        jsonb evidence
        timestamptz flagged_at
        timestamptz cleared_at "null = still active"
    }
    RESOURCE_OWNER {
        uuid id PK
        uuid tenant_id FK
        uuid resource_id FK
        text owner_email
        jsonb evidence
        enum confidence
        timestamptz attributed_at
    }
    SCAN {
        uuid id PK
        uuid tenant_id FK
        uuid cloud_account_id FK
        enum trigger "scheduled|manual"
        enum status
        int resource_count
        text snapshot_s3_key
        timestamptz started_at
        timestamptz finished_at
    }
    OWNER_IDENTITY_OVERRIDE {
        uuid id PK
        uuid tenant_id FK
        text principal_id UK "audit-trail identity, unique per tenant"
        text owner_email
    }
