{
  "AWS::EC2::Instance": {
    "enrichment_function": "enrich_ec2_instance",
    "fields": ["instance_type", "state", "launch_time", "vpc_id", "subnet_id", "attached_volume_ids"]
  },
  "AWS::EC2::Volume": {
    "enrichment_function": "enrich_ebs_volume",
    "fields": ["size_gib", "volume_type", "state", "attached_instance_id", "encrypted"]
  },
  "AWS::EC2::EIP": {
    "enrichment_function": "enrich_elastic_ip",
    "fields": ["public_ip", "association_state", "associated_instance_id"]
  },
  "AWS::S3::Bucket": {
    "enrichment_function": "enrich_s3_bucket",
    "fields": ["region", "versioning_status", "encryption", "public_access_blocked"]
  },
  "AWS::RDS::DBInstance": {
    "enrichment_function": "enrich_rds_instance",
    "fields": ["engine", "instance_class", "status", "multi_az", "storage_gib"]
  },
  "AWS::Lambda::Function": {
    "enrichment_function": "enrich_lambda_function",
    "fields": ["runtime", "memory_mb", "timeout_seconds", "last_modified", "state"]
  },
  "AWS::EKS::Cluster": {
    "enrichment_function": "enrich_eks_cluster",
    "fields": ["version", "status", "endpoint", "platform_version"]
  },
  "AWS::DynamoDB::Table": {
    "enrichment_function": "enrich_dynamodb_table",
    "fields": ["status", "item_count", "table_size_bytes", "billing_mode"]
  },
  "AWS::ElasticLoadBalancingV2::LoadBalancer": {
    "enrichment_function": "enrich_elb_v2",
    "fields": ["type", "scheme", "state", "vpc_id"]
  },
  "AWS::IAM::Role": {
    "enrichment_function": "enrich_iam_role",
    "fields": ["create_date", "max_session_duration", "attached_policy_count"]
  }
}
